{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/dotify\/choosingspeakers"]}],"hierarchy":{"paths":[["doc:\/\/Dotify\/documentation\/Dotify"]]},"abstract":[{"type":"text","text":"Play on the Mac’s outputs, Bluetooth speakers, AirPlay receivers or Spotify Connect devices."}],"identifier":{"url":"doc:\/\/Dotify\/documentation\/Dotify\/ChoosingSpeakers","interfaceLanguage":"swift"},"kind":"article","metadata":{"role":"article","title":"Choosing Speakers","roleHeading":"Article","modules":[{"name":"Dotify"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Open the speaker picker with ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"D"}]},{"text":", the speaker button in the toolbar or Card layout, or ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Choose Speaker…"}]},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"text":"menu. It has four sections.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"speakers"}]},{"text":"This Mac","type":"heading","anchor":"This-Mac","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Mac’s audio outputs: built-in speakers, connected Bluetooth devices, USB audio and display audio. Picking one"},{"type":"text","text":" "},{"type":"text","text":"makes it the Mac’s default output, which Spotify follows. If Spotify was playing on another device, Dotify also moves"},{"type":"text","text":" "},{"type":"text","text":"playback back to this Mac."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Virtual drivers such as BlackHole, Teams and remote-desktop audio are hidden under "},{"type":"strong","inlineContent":[{"text":"More","type":"text"}]},{"type":"text","text":"."}]},{"type":"heading","text":"Bluetooth · Not Connected","level":2,"anchor":"Bluetooth--Not-Connected"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Paired speakers and headphones that aren’t connected. Click one to connect it and switch sound to it. Connected"},{"type":"text","text":" "},{"type":"text","text":"Bluetooth devices appear under "},{"type":"strong","inlineContent":[{"text":"This Mac","type":"text"}]},{"type":"text","text":"."}]},{"type":"heading","text":"AirPlay","level":2,"anchor":"AirPlay"},{"type":"paragraph","inlineContent":[{"type":"text","text":"AirPlay receivers on your network. Sonos speakers are labelled. macOS doesn’t let apps choose an AirPlay target, so"},{"type":"text","text":" "},{"type":"text","text":"clicking one opens Sound settings, where it’s one click under "},{"type":"strong","inlineContent":[{"text":"Output","type":"text"}]},{"type":"text","text":". Once chosen it appears under "},{"type":"strong","inlineContent":[{"text":"This Mac","type":"text"}]},{"type":"text","text":"."}]},{"type":"heading","text":"Spotify Connect","level":2,"anchor":"Spotify-Connect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Network speakers, TVs, phones and other devices running Spotify. Click one to move playback there. The active device"},{"type":"text","text":" "},{"type":"text","text":"gets its own volume slider. The list refreshes every five seconds while the picker is open."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This section needs a Spotify connection with playback permissions, and Spotify Premium. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ConnectingSpotify"},{"type":"text","text":"."}]},{"type":"heading","text":"Sonos speakers","level":2,"anchor":"Sonos-speakers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Spotify’s Web API usually leaves Sonos speakers out of its device list, or marks them as uncontrollable. Spotify has"},{"type":"text","text":" "},{"type":"text","text":"acknowledged this for years. Ways to reach a Sonos speaker from Dotify:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"AirPlay","type":"text"}]},{"type":"text","text":": pick it in the AirPlay section, then select it in Sound settings."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Bluetooth","type":"text"}]},{"type":"text","text":": speakers with Bluetooth, such as the Sonos Move, can be paired with the Mac and then connected in one"},{"type":"text","text":" "},{"type":"text","text":"click from the Bluetooth section."}]}]}]}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Using-Dotify","title":"Using Dotify","identifiers":["doc:\/\/Dotify\/documentation\/Dotify\/GettingStarted","doc:\/\/Dotify\/documentation\/Dotify\/LayoutsAndControls","doc:\/\/Dotify\/documentation\/Dotify\/SearchAndHistory","doc:\/\/Dotify\/documentation\/Dotify\/ConnectingSpotify"],"generated":true}],"references":{"speakers":{"alt":"The speaker picker with This Mac, Bluetooth, AirPlay and Spotify Connect sections.","variants":[{"url":"\/images\/Dotify\/speakers@2x.png","traits":["2x","light"]}],"identifier":"speakers","type":"image"},"doc://Dotify/documentation/Dotify/LayoutsAndControls":{"abstract":[{"type":"text","text":"Pick how much screen the player takes, and control it from the keyboard."}],"role":"article","url":"\/documentation\/dotify\/layoutsandcontrols","title":"Layouts and Controls","type":"topic","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/LayoutsAndControls","kind":"article"},"doc://Dotify/documentation/Dotify":{"abstract":[{"type":"text","text":"A tiny floating Spotify player for macOS with six layouts, search, and speaker switching."}],"role":"collection","title":"Dotify","url":"\/documentation\/dotify","type":"topic","identifier":"doc:\/\/Dotify\/documentation\/Dotify","kind":"symbol"},"doc://Dotify/documentation/Dotify/GettingStarted"