{"hierarchy":{"paths":[["doc:\/\/Dotify\/documentation\/Dotify"]]},"identifier":{"url":"doc:\/\/Dotify\/documentation\/Dotify\/ChoosingSpeakers","interfaceLanguage":"swift"},"abstract":[{"text":"Play on the Mac’s outputs, Bluetooth speakers, AirPlay receivers or Spotify Connect devices.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/dotify\/choosingspeakers"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Using-Dotify","title":"Using Dotify","identifiers":["doc:\/\/Dotify\/documentation\/Dotify\/GettingStarted","doc:\/\/Dotify\/documentation\/Dotify\/LayoutsAndControls","doc:\/\/Dotify\/documentation\/Dotify\/SearchAndHistory","doc:\/\/Dotify\/documentation\/Dotify\/ConnectingSpotify"]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Open the speaker picker with "},{"type":"strong","inlineContent":[{"type":"text","text":"D"}]},{"type":"text","text":", the speaker button in the toolbar or Card layout, or "},{"type":"strong","inlineContent":[{"type":"text","text":"Choose Speaker…"}]},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"menu. It has four sections."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"speakers"}],"type":"paragraph"},{"type":"heading","text":"This Mac","anchor":"This-Mac","level":2},{"inlineContent":[{"type":"text","text":"The Mac’s audio outputs: built-in speakers, connected Bluetooth devices, USB audio and display audio. Picking one"},{"type":"text","text":" "},{"type":"text","text":"makes it the Mac’s default output, which Spotify follows. If Spotify was playing on another device, Dotify also moves"},{"type":"text","text":" "},{"type":"text","text":"playback back to this Mac."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Virtual drivers such as BlackHole, Teams and remote-desktop audio are hidden under "},{"type":"strong","inlineContent":[{"type":"text","text":"More"}]},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Bluetooth · Not Connected","anchor":"Bluetooth--Not-Connected","level":2},{"inlineContent":[{"type":"text","text":"Paired speakers and headphones that aren’t connected. Click one to connect it and switch sound to it. Connected"},{"type":"text","text":" "},{"type":"text","text":"Bluetooth devices appear under "},{"type":"strong","inlineContent":[{"type":"text","text":"This Mac"}]},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"AirPlay","anchor":"AirPlay","level":2},{"inlineContent":[{"type":"text","text":"AirPlay receivers on your network. Sonos speakers are labelled. macOS doesn’t let apps choose an AirPlay target, so"},{"type":"text","text":" "},{"type":"text","text":"clicking one opens Sound settings, where it’s one click under "},{"type":"strong","inlineContent":[{"type":"text","text":"Output"}]},{"type":"text","text":". Once chosen it appears under "},{"type":"strong","inlineContent":[{"type":"text","text":"This Mac"}]},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Spotify Connect","anchor":"Spotify-Connect","level":2},{"inlineContent":[{"type":"text","text":"Network speakers, TVs, phones and other devices running Spotify. Click one to move playback there. The active device"},{"type":"text","text":" "},{"type":"text","text":"gets its own volume slider. The list refreshes every five seconds while the picker is open."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This section needs a Spotify connection with playback permissions, and Spotify Premium. See "},{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ConnectingSpotify","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Sonos speakers","anchor":"Sonos-speakers","level":2},{"inlineContent":[{"type":"text","text":"Spotify’s Web API usually leaves Sonos speakers out of its device list, or marks them as uncontrollable. Spotify has"},{"type":"text","text":" "},{"type":"text","text":"acknowledged this for years. Ways to reach a Sonos speaker from Dotify:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"AirPlay","type":"text"}],"type":"strong"},{"text":": pick it in the AirPlay section, then select it in Sound settings.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Bluetooth","type":"text"}],"type":"strong"},{"text":": speakers with Bluetooth, such as the Sonos Move, can be paired with the Mac and then connected in one","type":"text"},{"text":" ","type":"text"},{"text":"click from the Bluetooth section.","type":"text"}]}]}]}],"kind":"content"}],"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"Dotify"}],"title":"Choosing Speakers","role":"article"},"references":{"doc://Dotify/documentation/Dotify/SearchAndHistory":{"role":"article","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SearchAndHistory","kind":"article","title":"Search and Recently Played","type":"topic","abstract":[{"text":"Find songs, playlists and podcasts, or jump back to something you played.","type":"text"}],"url":"\/documentation\/dotify\/searchandhistory"},"doc://Dotify/documentation/Dotify/ConnectingSpotify":{"kind":"article","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ConnectingSpotify","abstract":[{"type":"text","text":"Enable search, full listening history and Spotify Connect speakers."}],"title":"Connecting Spotify","url":"\/documentation\/dotify\/connectingspotify","role":"article","type":"topic"},"doc://Dotify/documentation/Dotify/LayoutsAndControls":{"role":"article","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/LayoutsAndControls","kind":"article","title":"Layouts and Controls","type":"topic","abstract":[{"type":"text","text":"Pick how much screen the player takes, and control it from the keyboard."}],"url":"\/documentation\/dotify\/layoutsandcontrols"},"doc://Dotify/documentation/Dotify/GettingStarted":{"role":"article","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/GettingStarted","kind":"article","title":"Getting Started","type":"topic","abstract":[{"type":"text","text":"Install or build Dotify, grant its permissions and start playing."}],"url":"\/documentation\/dotify\/gettingstarted"},"doc://Dotify/documentation/Dotify":{"abstract":[{"type":"text","text":"A tiny floating Spotify player for macOS with six layouts, search, and speaker switching."}],"identifier":"doc:\/\/Dotify\/documentation\/Dotify","role":"collection","kind":"symbol","type":"topic","url":"\/documentation\/dotify","title":"Dotify"},"speakers":{"alt":"The speaker picker with This Mac, Bluetooth, AirPlay and Spotify Connect sections.","type":"image","identifier":"speakers","variants":[{"traits":["2x","light"],"url":"\/images\/Dotify\/speakers@2x.png"}]}}}