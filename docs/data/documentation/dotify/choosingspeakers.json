":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Bluetooth"}],"type":"strong"},{"text":": speakers with Bluetooth, such as the Sonos Move, can be paired with the Mac and then connected in one","type":"text"},{"text":" ","type":"text"},{"text":"click from the Bluetooth section.","type":"text"}]}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Dotify\/documentation\/Dotify"]]},"seeAlsoSections":[{"title":"Using Dotify","identifiers":["doc:\/\/Dotify\/documentation\/Dotify\/GettingStarted","doc:\/\/Dotify\/documentation\/Dotify\/LayoutsAndControls","doc:\/\/Dotify\/documentation\/Dotify\/SearchAndHistory","doc:\/\/Dotify\/documentation\/Dotify\/ConnectingSpotify"],"generated":true,"anchor":"Using-Dotify"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/dotify\/choosingspeakers"]}],"abstract":[{"type":"text","text":"Play on the Mac’s outputs, Bluetooth speakers, AirPlay receivers or Spotify Connect devices."}],"references":{"doc://Dotify/documentation/Dotify":{"title":"Dotify","url":"\/documentation\/dotify","abstract":[{"text":"A tiny floating Spotify player for macOS with six layouts, search, and speaker switching.","type":"text"}],"type":"topic","role":"collection","kind":"symbol","identifier":"doc:\/\/Dotify\/documentation\/Dotify"},"doc://Dotify/documentation/Dotify/SearchAndHistory":{"url":"\/documentation\/dotify\/searchandhistory","title":"Search and Recently Played","kind":"article","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SearchAndHistory","abstract":[{"type":"text","text":"Find songs, playlists and podcasts, or jump back to something you played."}],"role":"article","type":"topic"},"doc://Dotify/documentation/Dotify/ConnectingSpotify":{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ConnectingSpotify","type":"topic","kind":"article","title":"Connecting Spotify","url":"\/documentation\/dotify\/connectingspotify","role":"article","abstract":[{"tex