}]},"doc://Dotify/documentation/Dotify/AirPlayBrowser":{"navigatorTitle":[{"kind":"identifier","text":"AirPlayBrowser"}],"abstract":[{"text":"Watches the local network for AirPlay receivers, and Sonos rooms so we can label them.","type":"text"},{"text":" ","type":"text"},{"text":"Apps can’t pick an AirPlay target themselves, so these are listed for the user to choose in Sound settings.","type":"text"}],"kind":"symbol","title":"AirPlayBrowser","type":"topic","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/AirPlayBrowser","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AirPlayBrowser"}],"url":"\/documentation\/dotify\/airplaybrowser","role":"symbol"},"doc://Dotify/documentation/Dotify/PanelController":{"title":"PanelController","role":"symbol","type":"topic","url":"\/documentation\/dotify\/panelcontroller","kind":"symbol","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PanelController","abstract":[],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PanelController"}],"navigatorTitle":[{"kind":"identifier","text":"PanelController"}]},"doc://Dotify/documentation/Dotify/LibraryStore":{"url":"\/documentation\/dotify\/librarystore","kind":"symbol","title":"LibraryStore","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LibraryStore"}],"type":"topic","abstract":[{"type":"text","text":"Search and recently played, filtered by kind. Recents merge Spotify’s history (songs and"},{"type":"text","text":" "},{"type":"text","text":"the playlists they came from) with a local history of everything Dotify saw play,"},{"type":"text","text":" "},{"type":"text","text":"which is the only source for podcast episodes."}],"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/LibraryStore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LibraryStore"}]},"doc://Dotify/documentation/Dotify/MediaItem":{"navigatorTi