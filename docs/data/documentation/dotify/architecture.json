{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dotify is a single Swift Package Manager executable built with SwiftUI and AppKit. It has three windows and two ways"},{"type":"text","text":" "},{"type":"text","text":"of talking to Spotify."}]},{"syntax":null,"code":["            ┌──────────────── AppModel (shared state) ────────────────┐","            │                                                          │","  Spotify desktop app ◀─AppleScript─ SpotifyController ─▶ PanelController ─▶ player window","                                          │","                                          └─track changes─▶ LibraryStore ─▶ search window","                                                               ▲","  Spotify Web API ◀── SpotifyAPI ◀── SpotifyAuth (PKCE)        │","                         ▲                                     │","                         └──────────────── DeviceStore ─▶ speaker window","                                              ▲","                     CoreAudio · IOBluetooth · Bonjour"],"type":"codeListing"},{"anchor":"Playback-AppleScript","level":2,"text":"Playback: AppleScript","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyController","isActive":true,"type":"reference"},{"text":" polls the Spotify desktop app once a second through ","type":"text"},{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ScriptRunner","isActive":true,"type":"reference"},{"text":". It also refreshes","type":"text"},{"text":" ","type":"text"},{"text":"immediately when Spotify posts its ","type":"text"},{"code":"com.spotify.client.PlaybackStateChanged","type":"codeVoice"},{"text":" distributed notification. Scripts run on","type":"text"},{"text":" ","type":"text"},{"text":"one serial queue and are compiled once.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Between polls, the playback position is interpolated locally so progress bars move smoothly. After a local change,"},{"type":"text","text":" "},{"type":"text","text":"such as seeking or changing volume, polled values are ignored for a moment so the UI doesn’t snap back."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Commands such as play\/pause, next, seek, volume, shuffle and "},{"type":"codeVoice","code":"play track <uri>"},{"type":"text","text":" are one-line AppleScript calls. The"},{"type":"text","text":" "},{"type":"text","text":"controller checks whether Spotify is running first, because addressing it would otherwise launch it."}],"type":"paragraph"},{"anchor":"Web-API-sign-in-and-requests","level":2,"text":"Web API: sign-in and requests","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAuth","type":"reference","isActive":true},{"type":"text","text":" implements Authorization Code with PKCE. "},{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/LoopbackServer","type":"reference","isActive":true},{"type":"text","text":" accepts exactly one "},{"type":"codeVoice","code":"\/callback"},{"type":"text","text":" request on"},{"type":"text","text":" "},{"code":"127.0.0.1:43821","type":"codeVoice"},{"text":" using Network.framework. The refresh token lives in the Keychain via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/Keychain","type":"reference"},{"text":". Access tokens are","type":"text"},{"text":" ","type":"text"},{"text":"kept in memory and refreshed on demand, with concurrent callers sharing one refresh.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAPI","isActive":true,"type":"reference"},{"text":" is a thin client that retries once after a 401 with a fresh token, and maps Spotify’s JSON into","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/MediaItem","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ConnectDevice","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Search and history","anchor":"Search-and-history","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/LibraryStore","type":"reference"},{"text":" owns the query, the multi-select ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/MediaKind","type":"reference"},{"text":" filters, debounced search results and Recently Played.","type":"text"},{"text":" ","type":"text"},{"text":"Recently Played merges Spotify’s history with a local history that ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyController","type":"reference"},{"text":" feeds through its","type":"text"},{"text":" ","type":"text"},{"code":"onTrackChange","type":"codeVoice"},{"text":" callback. The local history is the only source of podcast episodes.","type":"text"}],"type":"paragraph"},{"text":"Speakers","anchor":"Speakers","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/DeviceStore","isActive":true,"type":"reference"},{"text":" combines four sources:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/AudioOutputs"},{"type":"text","text":": CoreAudio outputs and the default output device, with a listener for changes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/BluetoothAudio","isActive":true},{"type":"text","text":": paired audio-class devices from IOBluetooth, connected with "},{"type":"codeVoice","code":"openConnection()"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/AirPlayBrowser","type":"reference"},{"text":": ","type":"text"},{"code":"_airplay._tcp","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"_sonos._tcp","type":"codeVoice"},{"text":" Bonjour browsing, to list AirPlay receivers and label Sonos rooms.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAPI"},{"type":"text","text":": Spotify Connect devices and playback transfer."}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Player window","anchor":"Player-window"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PanelController","isActive":true},{"type":"text","text":" owns the borderless, non-activating "},{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PlayerPanel","isActive":true},{"type":"text","text":". It reacts to "},{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/Preferences","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PanelState","isActive":true},{"type":"text","text":" (hover, focus, toolbar):"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"It resizes for layout changes, keeping the top-left corner fixed."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It adds or removes the toolbar strip using "},{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PanelGeometry","isActive":true},{"type":"text","text":". The strip goes on the top edge, or the bottom if there’s"},{"type":"text","text":" "},{"type":"text","text":"no room above, and is removed from the same edge, so the player never drifts."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It fades the window to the idle opacity when the player is neither hovered nor focused.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"It handles keyboard shortcuts."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/RootView","isActive":true,"type":"reference"},{"type":"text","text":" picks the layout view and stacks "},{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PlayerToolbar","isActive":true,"type":"reference"},{"type":"text","text":" on the correct edge."}],"type":"paragraph"},{"type":"heading","text":"Persistence","level":2,"anchor":"Persistence"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Where","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"UserDefaults (","type":"text"},{"type":"codeVoice","code":"local.dotify"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layout, opacity, idle opacity, toggles, panel position, window frames, Client ID, granted scopes, filters, local history"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Keychain (service ","type":"text"},{"code":"local.dotify","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Spotify refresh token"}]}]]]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"code":"swift test","type":"codeVoice"},{"text":" covers the loopback callback server, history merging and filters, CoreAudio output listing, and the","type":"text"},{"text":" ","type":"text"},{"text":"toolbar frame math. Tests use a separate Keychain service so they never touch the real sign-in.","type":"text"}]},{"level":2,"anchor":"Screenshots-and-demo-mode","type":"heading","text":"Screenshots and demo mode"},{"inlineContent":[{"type":"text","text":"The images in these docs come from the app itself. "},{"code":"DOTIFY_SNAPSHOT_DIR=\/some\/dir","type":"codeVoice"},{"text":" makes Dotify render every layout,","type":"text"},{"text":" ","type":"text"},{"text":"the toolbar, idle dimming, the search window and the speaker picker to 2x PNGs (see ","type":"text"},{"code":"Screenshots","type":"codeVoice"},{"text":"), then quit. It","type":"text"},{"text":" ","type":"text"},{"text":"restores any settings it changed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"DOTIFY_DEMO=1","type":"codeVoice"},{"type":"text","text":" swaps in made-up content (see "},{"type":"codeVoice","code":"Demo"},{"type":"text","text":"): a fictional track with generated artwork, sample search"},{"type":"text","text":" "},{"type":"text","text":"results and history, sample speakers, and a pretend Spotify connection. Nothing in demo mode touches Spotify, the"},{"type":"text","text":" "},{"type":"text","text":"Keychain, your saved Client ID or your listening history, so the images never show real accounts, artwork or device"},{"type":"text","text":" "},{"type":"text","text":"names."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"code":"make-screenshots.sh","type":"codeVoice"},{"text":" runs both against a separate app instance and copies the PNGs into","type":"text"},{"text":" ","type":"text"},{"code":"Sources\/Dotify\/Dotify.docc\/Resources","type":"codeVoice"},{"text":":","type":"text"}]},{"code":[".\/make-screenshots.sh   # refresh the images",".\/generate-docs.sh      # rebuild the docs site"],"syntax":"sh","type":"codeListing"}],"kind":"content"}],"abstract":[{"type":"text","text":"How Dotify is put together."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/dotify\/architecture"]}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Dotify\/documentation\/Dotify"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Dotify\/documentation\/Dotify\/Architecture"},"metadata":{"modules":[{"name":"Dotify"}],"role":"article","title":"Architecture","roleHeading":"Article"},"references":{"doc://Dotify/documentation/Dotify/SpotifyController":{"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpotifyController","kind":"identifier"}],"abstract":[{"type":"text","text":"Talks to the Spotify desktop app over AppleScript. Spotify can stay hidden;"},{"type":"text","text":" "},{"type":"text","text":"this app is the only UI you need to look at."}],"role":"symbol","navigatorTitle":[{"text":"SpotifyController","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyController","title":"SpotifyController","url":"\/documentation\/dotify\/spotifycontroller"},"doc://Dotify/documentation/Dotify/PlayerToolbar":{"abstract":[{"type":"text","text":"Quick access to the speaker picker, layouts and search."}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlayerToolbar"}],"url":"\/documentation\/dotify\/playertoolbar","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PlayerToolbar","title":"PlayerToolbar","navigatorTitle":[{"kind":"identifier","text":"PlayerToolbar"}]},"doc://Dotify/documentation/Dotify/SpotifyAPI":{"abstract":[{"text":"Thin Spotify Web API client. Development-mode limits apply: search returns at most 10 per type.","type":"text"}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpotifyAPI"}],"url":"\/documentation\/dotify\/spotifyapi","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAPI","title":"SpotifyAPI","navigatorTitle":[{"kind":"identifier","text":"SpotifyAPI"}]},"doc://Dotify/documentation/Dotify":{"title":"Dotify","url":"\/documentation\/do