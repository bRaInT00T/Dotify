PlayerPanel","title":"PlayerPanel","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlayerPanel"}],"navigatorTitle":[{"kind":"identifier","text":"PlayerPanel"}],"role":"symbol"},"doc://Dotify/documentation/Dotify/Keychain":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Keychain","kind":"identifier"}],"url":"\/documentation\/dotify\/keychain","navigatorTitle":[{"text":"Keychain","kind":"identifier"}],"abstract":[],"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/Keychain","type":"topic","kind":"symbol","role":"symbol","title":"Keychain"},"doc://Dotify/documentation/Dotify/AudioOutputs":{"kind":"symbol","url":"\/documentation\/dotify\/audiooutputs","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AudioOutputs"}],"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/AudioOutputs","title":"AudioOutputs","abstract":[{"type":"text","text":"Spotify plays through the Mac’s default output, so switching it moves Spotify too."}],"navigatorTitle":[{"kind":"identifier","text":"AudioOutputs"}],"type":"topic"},"doc://Dotify/documentation/Dotify/SpotifyAuth":{"navigatorTitle":[{"text":"SpotifyAuth","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SpotifyAuth","kind":"identifier"}],"role":"symbol","url":"\/documentation\/dotify\/spotifyauth","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAuth","abstract":[{"type":"text","text":"Spotify Web API sign-in using Authorization Code + PKCE (no client secret) with a"},{"type":"text","text":" "},{"type":"text","text":"loopback redirect, which is what Spotify requires for desktop apps."}],"kind":"symbol","type":"topic","title":"SpotifyAuth"},"doc://Dotify/documentation/Dotify/Preferences":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Preferenc