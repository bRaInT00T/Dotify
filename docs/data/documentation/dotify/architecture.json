ifier","text":"AudioOutputs"}],"abstract":[{"text":"Spotify plays through the Mac’s default output, so switching it moves Spotify too.","type":"text"}],"kind":"symbol","title":"AudioOutputs","type":"topic","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/AudioOutputs","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"AudioOutputs"}],"url":"\/documentation\/dotify\/audiooutputs","role":"symbol"},"doc://Dotify/documentation/Dotify/ConnectDevice":{"navigatorTitle":[{"kind":"identifier","text":"ConnectDevice"}],"abstract":[],"kind":"symbol","title":"ConnectDevice","type":"topic","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ConnectDevice","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ConnectDevice"}],"url":"\/documentation\/dotify\/connectdevice","role":"symbol"},"doc://Dotify/documentation/Dotify/PlayerPanel":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlayerPanel"}],"abstract":[{"type":"text","text":"Borderless floating panel that can take key focus (for keyboard shortcuts)"},{"type":"text","text":" "},{"text":"without activating the app or stealing focus from whatever you’re working in.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PlayerPanel","kind":"symbol","url":"\/documentation\/dotify\/playerpanel","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PlayerPanel"}],"title":"PlayerPanel"},"doc://Dotify/documentation/Dotify/RootView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RootView"}],"abstract":[],"role":"symbol","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/RootView","kind":"symbol","url":"\/documentation\/dotify\/rootview","type":"topic","navigatorTitle":[{"text":"RootView","kind":"identifier"}],"title":"RootView"},"doc://Dotify/documentation/Dotify/PanelState":{"