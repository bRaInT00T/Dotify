{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Dotify\/documentation\/Dotify\/Architecture"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Dotify\/documentation\/Dotify"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dotify is a single Swift Package Manager executable built with SwiftUI and AppKit. It has three windows and two ways"},{"type":"text","text":" "},{"type":"text","text":"of talking to Spotify."}]},{"type":"codeListing","code":["            ┌──────────────── AppModel (shared state) ────────────────┐","            │                                                          │","  Spotify desktop app ◀─AppleScript─ SpotifyController ─▶ PanelController ─▶ player window","                                          │","                                          └─track changes─▶ LibraryStore ─▶ search window","                                                               ▲","  Spotify Web API ◀── SpotifyAPI ◀── SpotifyAuth (PKCE)        │","                         ▲                                     │","                         └──────────────── DeviceStore ─▶ speaker window","                                              ▲","                     CoreAudio · IOBluetooth · Bonjour"],"syntax":null},{"text":"Playback: AppleScript","type":"heading","level":2,"anchor":"Playback-AppleScript"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyController"},{"type":"text","text":" polls the Spotify desktop app once a second through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ScriptRunner"},{"type":"text","text":". It also refreshes"},{"text":" ","type":"text"},{"text":"immediately when Spotify posts its ","type":"text"},{"code":"com.spotify.client.PlaybackStateChanged","type":"codeVoice"},{"text":" distributed notification. Scripts run on","type":"text"},{"text":" ","type":"text"},{"text":"one serial queue and are compiled once.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Between polls, the playback position is interpolated locally so progress bars move smoothly. After a local change,"},{"type":"text","text":" "},{"type":"text","text":"such as seeking or changing volume, polled values are ignored for a moment so the UI doesn’t snap back."}]},{"type":"paragraph","inlineContent":[{"text":"Commands such as play\/pause, next, seek, volume, shuffle and ","type":"text"},{"code":"play track <uri>","type":"codeVoice"},{"text":" are one-line AppleScript calls. The","type":"text"},{"text":" ","type":"text"},{"text":"controller checks whether Spotify is running first, because addressing it would otherwise launch it.","type":"text"}]},{"anchor":"Web-API-sign-in-and-requests","type":"heading","level":2,"text":"Web API: sign-in and requests"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAuth"},{"type":"text","text":" implements Authorization Code with PKCE. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/LoopbackServer"},{"type":"text","text":" accepts exactly one "},{"type":"codeVoice","code":"\/callback"},{"type":"text","text":" request on"},{"type":"text","text":" "},{"type":"codeVoice","code":"127.0.0.1:43821"},{"type":"text","text":" using Network.framework. The refresh token lives in the Keychain via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/Keychain"},{"type":"text","text":". Access tokens are"},{"type":"text","text":" "},{"type":"text","text":"kept in memory and refreshed on demand, with concurrent callers sharing one refresh."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAPI","type":"reference"},{"text":" is a thin client that retries once after a 401 with a fresh token, and maps Spotify’s JSON into","type":"text"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/MediaItem"},{"type":"text","text":" and "},{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ConnectDevice","type":"reference","isActive":true},{"type":"text","text":"."}]},{"anchor":"Search-and-history","text":"Search and history","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/LibraryStore","type":"reference","isActive":true},{"text":" owns the query, the multi-select ","type":"text"},{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/MediaKind","type":"reference","isActive":true},{"text":" filters, debounced search results and Recently Played.","type":"text"},{"text":" ","type":"text"},{"text":"Recently Played merges Spotify’s history with a local history that ","type":"text"},{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyController","type":"reference","isActive":true},{"text":" feeds through its","type":"text"},{"text":" ","type":"text"},{"code":"onTrackChange","type":"codeVoice"},{"text":" callback. The local history is the only source of podcast episodes.","type":"text"}]},{"anchor":"Speakers","text":"Speakers","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/DeviceStore"},{"type":"text","text":" combines four sources:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/AudioOutputs","isActive":true},{"type":"text","text":": CoreAudio outputs and the default output device, with a listener for changes."}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/BluetoothAudio"},{"type":"text","text":": paired audio-class devices from IOBluetooth, connected with "},{"type":"codeVoice","code":"openConnection()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/AirPlayBrowser"},{"type":"text","text":": "},{"type":"codeVoice","code":"_airplay._tcp"},{"type":"text","text":" and "},{"type":"codeVoice","code":"_sonos._tcp"},{"type":"text","text":" Bonjour browsing, to list AirPlay receivers and label Sonos rooms."}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAPI","type":"reference","isActive":true},{"type":"text","text":": Spotify Connect devices and playback transfer."}],"type":"paragraph"}]}]},{"text":"Player window","type":"heading","level":2,"anchor":"Player-window"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PanelController","type":"reference"},{"text":" owns the borderless, non-activating ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PlayerPanel","type":"reference"},{"text":". It reacts to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/Preferences","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PanelState","type":"reference"},{"text":" (hover, focus, toolbar):","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It resizes for layout changes, keeping the top-left corner fixed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It adds or removes the toolbar strip using ","type":"text"},{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PanelGeometry","isActive":true},{"text":". The strip goes on the top edge, or the bottom if there’s","type":"text"},{"text":" ","type":"text"},{"text":"no room above, and is removed from the same edge, so the player never drifts.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"It fades the window to the idle opacity when the player is neither hovered nor focused."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It handles keyboard shortcuts.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/RootView","isActive":true},{"type":"text","text":" picks the layout view and stacks "},{"type":"reference","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PlayerToolbar","isActive":true},{"type":"text","text":" on the correct edge."}]},{"level":2,"type":"heading","text":"Persistence","anchor":"Persistence"},{"rows":[[[{"inlineContent":[{"text":"Where","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"UserDefaults ("},{"type":"codeVoice","code":"local.dotify"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Layout, opacity, idle opacity, toggles, panel position, window frames, Client ID, granted scopes, filters, local history"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Keychain (service ","type":"text"},{"code":"local.dotify","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Spotify refresh token","type":"text"}]}]]],"header":"row","type":"table"},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"inlineContent":[{"type":"codeVoice","code":"swift test"},{"type":"text","text":" covers the loopback callback server, history merging and filters, CoreAudio output listing, and the"},{"text":" ","type":"text"},{"text":"toolbar frame math. Tests use a separate Keychain service so they never touch the real sign-in.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For visual checks, ","type":"text"},{"code":"DOTIFY_SNAPSHOT_DIR=\/some\/dir","type":"codeVoice"},{"text":" makes the app render every layout (collapsed and expanded), the","type":"text"},{"text":" ","type":"text"},{"text":"search window and the speaker window to PNGs, write the Spotify Connect and AirPlay device lists to ","type":"text"},{"code":"devices.txt","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"quit. Launch it with "},{"type":"codeVoice","code":"open"},{"type":"text","text":" so permission prompts are attributed to Dotify:"}]},{"code":["open -W --env DOTIFY_SNAPSHOT_DIR=\/tmp\/snaps build\/Dotify.app"],"type":"codeListing","syntax":"sh"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/dotify\/architecture"]}],"abstract":[{"text":"How Dotify is put together.","type":"text"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Dotify"}],"title":"Architecture"},"references":{"doc://Dotify/documentation/Dotify/SpotifyAPI":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SpotifyAPI"}],"type":"topic","kind":"symbol","url":"\/documentation\/dotify\/spotifyapi","title":"SpotifyAPI","abstract":[{"type":"text","text":"Thin Spotify Web API client. Development-mode limits apply: search returns at most 10 per type."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SpotifyAPI"}],"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAPI"},"doc://Dotify/documentation/Dotify/SpotifyController":{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyController","kind":"symbol","role":"symbol","url":"\/documentation\/dotify\/spotifycontroller","navigatorTitle":[{"kind":"identifi