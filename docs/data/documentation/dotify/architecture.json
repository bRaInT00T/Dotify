otify\/documentation\/Dotify\/AudioOutputs"},"doc://Dotify/documentation/Dotify/LibraryStore":{"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"LibraryStore"}],"title":"LibraryStore","type":"topic","abstract":[{"type":"text","text":"Search and recently played, filtered by kind. Recents merge Spotify’s history (songs and"},{"type":"text","text":" "},{"text":"the playlists they came from) with a local history of everything Dotify saw play,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which is the only source for podcast episodes."}],"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/LibraryStore","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LibraryStore"}],"url":"\/documentation\/dotify\/librarystore"},"doc://Dotify/documentation/Dotify/LoopbackServer":{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/LoopbackServer","type":"topic","kind":"symbol","navigatorTitle":[{"text":"LoopbackServer","kind":"identifier"}],"title":"LoopbackServer","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LoopbackServer","kind":"identifier"}],"url":"\/documentation\/dotify\/loopbackserver","role":"symbol","abstract":[{"type":"text","text":"Listens on 127.0.0.1 for exactly one "},{"type":"codeVoice","code":"\/callback"},{"type":"text","text":" request from the browser."}]},"doc://Dotify/documentation/Dotify/SpotifyAuth":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"SpotifyAuth"}],"navigatorTitle":[{"kind":"identifier","text":"SpotifyAuth"}],"kind":"symbol","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/SpotifyAuth","title":"SpotifyAuth","role":"symbol","url":"\/documentation\/dotify\/spotifyauth","type":"topic","abstract":[{"type":"text","text":"Spotify Web API sign-in using Authorization Code + PKCE (no client secret) with a"},{"type":"text","text":" "},{"type":"text","text":"loopback redirect, which is what Spotify requires for desktop apps."}]},"doc://Dotify/documentation/Dotify/ScriptRunner":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ScriptRunner","kind":"identifier"}],"navigatorTitle":[{"text":"ScriptRunner","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/ScriptRunner","title":"ScriptRunner","role":"symbol","url":"\/documentation\/dotify\/scriptrunner","type":"topic","abstract":[{"type":"text","text":"Runs AppleScript off the main thread on a single serial queue, caching compiled scripts."}]},"doc://Dotify/documentation/Dotify/PanelState":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PanelState"}],"abstract":[{"type":"text","text":"Transient on-screen state of the player panel (not persisted)."}],"url":"\/documentation\/dotify\/panelstate","title":"PanelState","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"PanelState","kind":"identifier"}],"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PanelState","type":"topic","kind":"symbol"},"doc://Dotify/documentation/Dotify/PanelGeometry":{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PanelGeometry","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PanelGeometry"}],"title":"PanelGeometry","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"PanelGeometry"}],"url":"\/documentation\/dotify\/panelgeometry","role":"symbol","abstract":[{"type":"text","text":"Frame math for the player window and its toolbar strip."}]},"doc://Dotify/documentation/Dotify/Keychain":{"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/Keychain","type":"topic","kind":"symbol","navigatorTitle":[{"text":"Keychain","kind":"identifier"}],"title":"Keychain","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Keychain","kind":"identifier"}],"url":"\/documentation\/dotify\/keychain","role":"symbol","abstract":[]},"doc://Dotify/documentation/Dotify/RootView":{"abstract":[],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootView","kind":"identifier"}],"navigatorTitle":[{"text":"RootView","kind":"identifier"}],"kind":"symbol","title":"RootView","role":"symbol","type":"topic","url":"\/documentation\/dotify\/rootview","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/RootView"},"doc://Dotify/documentation/Dotify/BluetoothAudio":{"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"BluetoothAudio","kind":"identifier"}],"title":"BluetoothAudio","abstract":[],"role":"symbol","navigatorTitle":[{"text":"BluetoothAudio","kind":"identifier"}],"identifier":"doc:\/\/Dotify\/documentation\/Dotify\/BluetoothAudio","kind":"symbol","url":"\/documentation\/dotify\/bluetoothaudio"},"doc://Dotify/documentation/Dotify/PlayerPanel":{"abstract":[{"type":"text","text":"Borderless floating panel that can take key focus (for keyboard shortcuts)"},{"type":"text","text":" "},{"type":"text","text":"without activating the app or stealing focus from whatever you’re working in."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlayerPanel","kind":"identifier"}],"navigatorTitle":[{"text":"PlayerPanel","kind":"identifier"}],"kind":"symbol","title":"PlayerPanel","role":"symbol","type":"topic","url":"\/documentation\/dotify\/playerpanel","identifier":"doc:\/\/Dotify\/documentation\/Dotify\/PlayerPanel"}}}